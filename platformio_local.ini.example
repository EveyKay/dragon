; Copy this file to platformio_local.ini (repo root) and fill in your
; actual values. platformio_local.ini is gitignored -- it never gets
; committed, so your OTA password doesn't end up on GitHub.
;
; PlatformIO merges this into platformio.ini automatically (see
; extra_configs in platformio.ini), adding these keys to the
; [env:esp32dev_ota] section defined there.

[env:esp32dev_ota]
upload_port = dragon.local
upload_flags =
    --auth=pick-an-ota-password
