// Copy this file to wifi_credentials.h (same folder) and fill in your
// actual network details. wifi_credentials.h is gitignored -- it never
// gets committed, so your WiFi password doesn't end up on GitHub.

#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Used to authenticate OTA (over-the-air) firmware uploads, so nothing
// else on the network can push new code to the dragon. Pick anything.
#define OTA_PASSWORD "pick-an-ota-password"
